# Copy to .env (local builds) and set the same values as GitHub repository secrets for CI.
# Find them in Supabase: Project Settings → API. The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
